{
  "name": "playwright-template",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright QA template — UI (AutomationExercise) + API (DummyJSON + AutomationExercise API)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --grep @api --project=chromium",
    "test:a11y": "playwright test --grep @a11y --project=chromium",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --project=chromium --update-snapshots",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed --project=chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,yml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,yml,md}\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "dotenv": "^16.4.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "node-fetch": "^3.3.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "zod": "^3.23.0"
  }
}
