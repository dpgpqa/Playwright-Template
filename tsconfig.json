{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@pages/*": ["src/pages/*"],
      "@components/*": ["src/components/*"],
      "@api/*": ["src/api/*"],
      "@fixtures/*": ["src/fixtures/*"],
      "@factories/*": ["src/factories/*"],
      "@utils/*": ["src/utils/*"],
      "@test-data/*": ["test-data/*"]
    },
    "types": ["@playwright/test", "node"]
  },
  "include": ["src/**/*", "tests/**/*", "test-data/**/*", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "reports", "test-results", "blob-report", ".auth"]
}